# TheYgent Development Environment Configuration
# Copy this to .env and customize as needed

# ── Database ────────────────────────────────────────────────────────
# Required. Postgres async DSN for the control plane.
# This must be set before running alembic migrations and starting the control plane.
DATABASE_URL=postgresql+asyncpg://theygent:theygent@localhost:5432/theygent

# ── Inference Plane ─────────────────────────────────────────────────
# The inference plane's data-plane root (must include /v1 if different)
THEYGENT_INFERENCE_PLANE_URL=http://127.0.0.1:8081/v1

# Listen address and port for the inference plane
THEYGENT_INFERENCE_PLANE_HOST=127.0.0.1
THEYGENT_INFERENCE_PLANE_PORT=8081

# Maximum number of resident inference engines at once
THEYGENT_MAX_RESIDENT=2

# ── Control Plane ───────────────────────────────────────────────────
# Listen address and port for the control plane API
THEYGENT_CONTROL_PLANE_HOST=127.0.0.1
THEYGENT_CONTROL_PLANE_PORT=8080

# ── CORS ────────────────────────────────────────────────────────────
# Origins allowed to call the inference plane and control plane directly from the browser.
# The visual interface SPA (:5174). Comma-separate to add more.
# Set to empty string to disable CORS (not recommended for local development).
THEYGENT_CORS_ORIGINS=http://localhost:5174

# ── Interface (React SPA) ───────────────────────────────────────────
# The visual interface runs on this port when you run `pnpm --filter @theygent/interface dev`
# (Not an environment variable — just noted here for completeness)
# Default: 5174

# ── Docker note ─────────────────────────────────────────────────────
# `docker compose` auto-loads this file for its ${…} interpolation, so the values below
# also configure the CONTAINERIZED stack (deliberately the same knobs as `make up`):
#   THEYGENT_DURABLE      opts the control-plane onto the durable runtime in both stacks
#   THEYGENT_SECRET_KEY   Fernet key(s) for stored secrets (unset = ephemeral, dev-only)
#   THEYGENT_INVOKE_TOKEN bearer token for unattended invocation (unset = closed)
#   THEYGENT_MAX_RESIDENT resident-engine cap for the containerized inference plane
# The in-container listen addresses/ports and DATABASE_URL are fixed by docker-compose.yml
# and ignore this file.

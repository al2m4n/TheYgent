# TheYgent Development Environment Configuration
# Copy this to .env and customize as needed

# ── Database ────────────────────────────────────────────────────────
# Required. Postgres async DSN for the control plane.
# This must be set before running alembic migrations and starting the control plane.
DATABASE_URL=postgresql+asyncpg://theygent:theygent@localhost:5432/theygent

# ── Inference Plane ─────────────────────────────────────────────────
# The inference plane's data-plane root (must include /v1 if different)
THEYGENT_INFERENCE_PLANE_URL=http://127.0.0.1:8081/v1

# Listen address and port for the inference plane
THEYGENT_INFERENCE_PLANE_HOST=127.0.0.1
THEYGENT_INFERENCE_PLANE_PORT=8081

# Maximum number of resident inference engines at once
THEYGENT_MAX_RESIDENT=2

# ── Control Plane ───────────────────────────────────────────────────
# Listen address and port for the control plane API
THEYGENT_CONTROL_PLANE_HOST=127.0.0.1
THEYGENT_CONTROL_PLANE_PORT=8080

# ── CORS ────────────────────────────────────────────────────────────
# Origins allowed to call the inference plane and control plane directly from the browser.
# The visual interface SPA (:5174). Comma-separate to add more.
# Set to empty string to disable CORS (not recommended for local development).
THEYGENT_CORS_ORIGINS=http://localhost:5174

# ── AI Gateway ──────────────────────────────────────────────────────
# Sits between Claude Code and its models; `make up` starts it on :8082. As configured here it
# is a personal gateway: loopback only, no keys, each developer's own Claude login or API key,
# records kept locally (`uv run --package theygent-ai-gateway theygent-ai-gateway report`).
THEYGENT_AI_GATEWAY_HOST=127.0.0.1
THEYGENT_AI_GATEWAY_PORT=8082
THEYGENT_AI_GATEWAY_AUTH_MODE=personal

# Attach it to the control plane (its traffic then shows on the AI Gateway page): the control
# plane's URL and a gateway service key, which an admin mints under AI Gateway → Settings →
# Service keys. A service key belongs to one control plane — the compose stack has its own.
THEYGENT_CONTROL_PLANE_URL=
THEYGENT_AI_GATEWAY_SERVICE_KEY=

# Team mode serves other machines and tells developers apart by their gateway keys: set
# THEYGENT_AI_GATEWAY_AUTH_MODE=team and THEYGENT_AI_GATEWAY_HOST=0.0.0.0, with the two above.
# For developers billed to the organization, its Anthropic key — or leave this empty and set
# it from AI Gateway → Settings, where it is kept on the gateway (never by the control plane).
THEYGENT_AI_GATEWAY_ORG_API_KEY=
# In router mode, the requests an admin sends to local models (AI Gateway → Settings → Local
# models) go to the inference plane at THEYGENT_INFERENCE_PLANE_URL (above); when it cannot
# answer, they go to the Anthropic API.

# ── Interface (React SPA) ───────────────────────────────────────────
# The visual interface runs on this port when you run `pnpm --filter @theygent/interface dev`
# (Not an environment variable — just noted here for completeness)
# Default: 5174

# ── Docker note ─────────────────────────────────────────────────────
# `docker compose` auto-loads this file for its ${…} interpolation, so the values below
# also configure the CONTAINERIZED stack (deliberately the same knobs as `make up`):
#   THEYGENT_DURABLE      opts the control-plane onto the durable runtime in both stacks
#   THEYGENT_SECRET_KEY   Fernet key(s) for stored secrets (unset = ephemeral, dev-only)
#   THEYGENT_INVOKE_TOKEN bearer token for unattended invocation (unset = closed)
#   THEYGENT_MAX_RESIDENT resident-engine cap for the containerized inference plane
#   THEYGENT_AI_GATEWAY_SERVICE_KEY / THEYGENT_AI_GATEWAY_ORG_API_KEY
#                         the containerized AI gateway (`docker compose --profile gateway up -d`)
# The in-container listen addresses/ports, auth modes, THEYGENT_CONTROL_PLANE_URL and
# DATABASE_URL are fixed by docker-compose.yml and ignore this file.

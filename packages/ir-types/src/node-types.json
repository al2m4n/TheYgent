    "ratelimit": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``ratelimit`` activity node config (m19.md \u00a72.8/\u00a71.6) \u2014 the lean per-key gate seam.\n``key_expr`` resolves the caller key from the M12 token / webhook signature or a ``$in`` field\n(per-USER is the deferred identity work \u2014 \u00a71.6). Denies past ``limit`` requests in\n``window_seconds`` per key, backed by a trivial Postgres counter. ``policy: \"deny\"`` emits the\n``deny`` port (a clean 429-style result); ``policy: \"wait\"`` (a bounded suspend) is NAMED, not\nbuilt in M19 \u2014 start with deny.",
        "properties": {
          "keyExpr": {
            "title": "Keyexpr",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "policy": {
            "default": "deny",
            "enum": [
              "deny",
              "wait"
            ],
            "title": "Policy",
            "type": "string"
          },
          "windowSeconds": {
            "title": "Windowseconds",
            "type": "integer"
          }
        },
        "required": [
          "keyExpr",
          "limit",
          "windowSeconds"
        ],
        "title": "RateLimitConfig",
        "type": "object"
      },
      "defaultConfig": {
        "keyExpr": "",
        "limit": 0,
        "policy": "deny",
        "windowSeconds": 0
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "allow",
            "type": "any"
          },
          {
            "id": "deny",
            "type": "any"
          }
        ]
      },
      "type": "ratelimit"
    },
    "router": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``router`` orchestration node config (\u00a78.3 / m6.md \u00a73.2). ``select`` is a ``$in``-reference\nthat must resolve to the **name of one of this node's outgoing handles** \u2014 handle-name routing,\nnot an expression DSL. The walker follows only the edge(s) from the selected handle.",
        "properties": {
          "select": {
            "title": "Select",
            "type": "string"
          }
        },
        "required": [
          "select"
        ],
        "title": "RouterConfig",
        "type": "object"
      },
      "defaultConfig": {
        "select": ""
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "router"
    },
    "speak": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``speak`` activity node config (m19.md \u00a72.2) \u2014 text in \u2192 audio-ref out, mapping 1:1 to\n``POST /v1/audio/speech`` (M18 \u00a71.1). ``model`` names a ``models`` key whose binding advertises\nthe ``audio.speech`` modality; ``params`` carries ``voice``/``format``/``speed``. The step's\nreturn value is a REFERENCE to the produced audio (bytes are an artifact, never journaled \u2014\nm13-dbos.md \u00a76); it feeds an ``output`` (``modality:audio``) or an action ``tool``.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "model"
        ],
        "title": "SpeakConfig",
        "type": "object"
      },
      "defaultConfig": {
        "model": "",
        "params": {}
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "text",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "audio",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          }
        ]
      },
      "type": "speak"
    },
    "subgraph": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``subgraph`` boundary node config (m14.md \u00a71.2) \u2014 an agent calls another SAVED agent, run as\na DBOS child workflow (independently durable + resumable). ``agent`` is the child's \u00a78.2 id; the\nnode pins it with EXACTLY ONE of ``version`` / ``content_hash`` (validated in\n``validate_graph``) and the pin is frozen into the parent's contentHash, so composition is\nimmutable. ``max_depth`` bounds recursion (the ``subgraph`` analogue of ``loop``'s\n``max_iterations``): exceeding it fails honestly, preventing unbounded / mutually-recursive\nexpansion. The parent's in-port value is the child's run input (M10 named ports); the child's\noutput binds the node's success handle.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent"
        ],
        "title": "SubgraphConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "contentHash": null,
        "maxDepth": 8,
        "version": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          }
        ]
      },
      "type": "subgraph"
    },
    "tool": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``tool`` activity node config (\u00a78.3 / m6.md \u00a72/\u00a73.1 + M19 \u00a72.3). ``tool`` is a logical name:\na key in ``ir.tools`` (an ``http`` connection-backed binding \u2014 M19 \u2014 or an M6 ``builtin``) OR a\ndirectly-registered builtin (``echo``/``http_fetch``). Membership is checked in the control\nplane, not here (``packages/ir`` stays pure).\n\nM6 path (builtin): ``args`` is the arg template \u2014 each value a literal or a ``$in``-reference\n(``$in`` = the whole in-port value, ``$in.a.b`` = a path into it) resolved before the call.\n\nM19 http path (when ``tool`` resolves to an ``http`` binding, \u00a72.3): the request is described by\nthe additive fields below, all optional so a builtin ``tool`` node is byte-identical to M6. The\nconnection (resolved from ``ir.tools[tool].connection``) injects auth headers SERVER-SIDE \u2014 auth\nnever appears in the IR or the rendered template. ``url_template``/``headers``/``body_template``\nuse the unified ``$in.field`` substitution; ``response_map`` is an optional JSONPath to shape\nthe step output; ``idempotency_key`` (set for unsafe methods \u2014 \u00a72.5) makes a partial-failure\nre-run a provider no-op.",
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "bodyTemplate": {
            "default": null,
            "title": "Bodytemplate"
          },
          "connection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "idempotencyKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Idempotencykey"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "parameterSchema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parameterschema"
          },
          "responseMap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Responsemap"
          },
          "timeoutSeconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeoutseconds"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "urlTemplate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Urltemplate"
          }
        },
        "required": [
          "tool"
        ],
        "title": "ToolConfig",
        "type": "object"
      },
      "defaultConfig": {
        "args": {},
        "bodyTemplate": null,
        "connection": null,
        "description": null,
        "headers": {},
        "idempotencyKey": null,
        "method": null,
        "parameterSchema": null,
        "responseMap": null,
        "timeoutSeconds": null,
        "tool": "",
        "urlTemplate": null
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          },
          {
            "id": "use",
            "role": "tool",
            "type": "any"
          }
        ]
      },
      "type": "tool"
    },
    "transcribe": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``transcribe`` activity node config (m19.md \u00a72.2) \u2014 audio-ref in \u2192 text out, mapping 1:1 to\n``POST /v1/audio/transcriptions`` (M18 \u00a71.1). ``model`` names a key in ``IRDocument.models``\nwhose binding's ``capabilities.modalities`` must include ``audio.transcription`` (data-driven \u2014\nan incompatible binding is rejected at run, not silently); ``params`` (language/prompt/\u2026) ride\nthrough to the endpoint. The audio bytes go to the inference base URL in the user's trust\ndomain, never the control plane (\u00a710 / M18 \u00a71.4).",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {

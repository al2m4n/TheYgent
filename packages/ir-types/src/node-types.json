{
  "types": {
    "guardrail": {
      "configSchema": {
        "$defs": {
          "GuardrailCheck": {
            "additionalProperties": false,
            "description": "The guardrail's check (m19.md \u00a72.6). ``type`` picks the backend: ``rule`` (deterministic,\n\u21d2orchestration) or ``model`` (a classifier call, \u21d2activity). Exactly the matching sub-config is\nset; the node's ``kind`` follows the backend and is validated against it (\u00a71.2).",
            "properties": {
              "model": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GuardrailModel"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "rule": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GuardrailRule"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "type": {
                "enum": [
                  "rule",
                  "model"
                ],
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "title": "GuardrailCheck",
            "type": "object"
          },
          "GuardrailModel": {
            "additionalProperties": false,
            "description": "A model guardrail check backend (m19.md \u00a72.6, ``check.type == \"model\"``) \u2014 an LLM-judge \"is\nthis in scope?\" classifier. ``model`` names a ``models`` key (a real data-plane call, so a model\nguardrail is ``kind: activity`` \u2014 \u00a71.2); ``prompt`` is the judge question; ``pass_on`` is the\nmodel answer that PASSES (default ``\"yes\"``) \u2014 anything else routes to ``block``.",
            "properties": {
              "model": {
                "title": "Model",
                "type": "string"
              },
              "passOn": {
                "default": "yes",
                "title": "Passon",
                "type": "string"
              },
              "prompt": {
                "title": "Prompt",
                "type": "string"
              }
            },
            "required": [
              "model",
              "prompt"
            ],
            "title": "GuardrailModel",
            "type": "object"
          },
          "GuardrailRule": {
            "additionalProperties": false,
            "description": "A deterministic guardrail check backend (m19.md \u00a72.6, ``check.type == \"rule\"``). ``kind``\nselects the predicate; ``spec`` carries its knob (the regex, the min/max length, the json\nschema, the allow/deny list, the PII pattern set). Evaluated INLINE over journaled input \u2014 no\nI/O, no latency \u2014 so a rule guardrail is ``kind: orchestration`` (\u00a71.2).",
            "properties": {
              "kind": {
                "enum": [
                  "regex",
                  "length",
                  "json_schema",
                  "allow",
                  "deny",
                  "pii"
                ],
                "title": "Kind",
                "type": "string"
              },
              "spec": {
                "additionalProperties": true,
                "title": "Spec",
                "type": "object"
              }
            },
            "required": [
              "kind"
            ],
            "title": "GuardrailRule",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "``guardrail`` node config (m19.md \u00a72.6) \u2014 a first-class check that short-circuits before\ndownstream work. ``pass`` carries the input through; ``block`` carries the ``on_block`` payload\n(or the violation) \u2014 wire it to an ``output`` to refuse BEFORE the expensive node. ``kind`` is\nper-instance (\u00a71.2): the editor stamps ``orchestration`` for a rule check, ``activity`` for a\nmodel check, and ``validate_graph`` enforces the match.",
        "properties": {
          "check": {
            "$ref": "#/$defs/GuardrailCheck"
          },
          "onBlock": {
            "additionalProperties": true,
            "title": "Onblock",
            "type": "object"
          }
        },
        "required": [
          "check"
        ],
        "title": "GuardrailConfig",
        "type": "object"
      },
      "defaultConfig": {
        "check": null,
        "onBlock": {}
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "pass",
            "type": "any"
          },
          {
            "id": "block",
            "type": "any"
          }
        ]
      },
      "type": "guardrail"
    },
    "human": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``human`` boundary node config (m14.md \u00a71.1) \u2014 a durable wait for external input. The node\nlowers onto ``DBOS.recv``: the run persists as ``waiting`` and survives a worker crash while\npaused; ``POST /runs/{id}/resume`` (\u2192 ``DBOS.send``) delivers the awaited input and the workflow\nresumes from the checkpoint. ``prompt`` describes what input is expected (advisory);\n``input_schema`` is the awaited input's declared shape (advisory in M14 \u2014 resume records it,\ndoesn't enforce a full JSON-Schema validation). ``timeout`` (seconds; ``None`` = wait forever)\nbounds the wait; on timeout the node fails honestly (``on_timeout='fail'``, the default \u2192\n``failed`` run, M9) or binds the declared ``default`` (``on_timeout='default'``).",
        "properties": {
          "default": {
            "default": null,
            "title": "Default"
          },
          "inputSchema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inputschema"
          },
          "onTimeout": {
            "default": "fail",
            "enum": [
              "fail",
              "default"
            ],
            "title": "Ontimeout",
            "type": "string"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prompt"
          },
          "timeout": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout"
          }
        },
        "title": "HumanConfig",
        "type": "object"
      },
      "defaultConfig": {
        "default": null,
        "inputSchema": null,
        "onTimeout": "fail",
        "prompt": null,
        "timeout": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "human"
    },
    "input": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``input`` boundary node \u2014 the single typed entry (M19 \u00a72.1, made real). ``modality`` declares\nthe payload shape (text by default \u2014 a pre-M19 input is unchanged); ``schema`` is the JSON\nSchema of the expected payload that M12 triggers map their source onto (\u00a71.5). Both are\ndeclarative \u2014 the walker still binds the run input to the out-port; modality/schema drive the\neditor + trigger mapping, not execution.",
        "properties": {
          "modality": {
            "default": "text",
            "enum": [
              "text",
              "audio",
              "image",
              "video",
              "json",
              "file"
            ],
            "title": "Modality",
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema"
          }
        },
        "title": "InputConfig",
        "type": "object"
      },
      "defaultConfig": {
        "modality": "text",
        "schema": null
      },
      "kind": "boundary",
      "ports": {
        "in": [],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "input"
    },
    "llm": {
      "configSchema": {
        "$defs": {
          "_ImageContentPart": {
            "additionalProperties": false,
            "description": "An OpenAI ``image_url`` content part \u2014 the block that carries a vision input.",
            "properties": {
              "imageUrl": {
                "$ref": "#/$defs/_ImageUrl"
              },
              "type": {
                "const": "image_url",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "imageUrl"
            ],
            "title": "_ImageContentPart",
            "type": "object"
          },
          "_ImageUrl": {
            "additionalProperties": false,
            "description": "The ``image_url`` payload of an image content part (OpenAI shape). ``url`` is an http(s) URL\nor a ``data:`` URI (base64-inline); it is ``$in``-templatable so the image can come from a graph\nin-port. ``detail`` is OpenAI's optional fidelity hint (``low``/``high``/``auto``).",
            "properties": {
              "detail": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Detail"
              },
              "url": {
                "title": "Url",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "title": "_ImageUrl",
            "type": "object"
          },
          "_Message": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "discriminator": {
                        "mapping": {
                          "image_url": "#/$defs/_ImageContentPart",
                          "text": "#/$defs/_TextContentPart"
                        },
                        "propertyName": "type"
                      },
                      "oneOf": [
                        {
                          "$ref": "#/$defs/_TextContentPart"
                        },
                        {
                          "$ref": "#/$defs/_ImageContentPart"
                        }
                      ]
                    },
                    "type": "array"
                  }
                ],
                "title": "Content"
              },
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ],
                "title": "Role",
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ],
            "title": "_Message",
            "type": "object"
          },
          "_NamedToolChoice": {
            "additionalProperties": false,
            "description": "Force a specific tool \u2014 OpenAI's ``{\"type\":\"function\",\"function\":{\"name\":...}}``.",
            "properties": {
              "function": {
                "$ref": "#/$defs/_ToolFunctionName"
              },
              "type": {
                "const": "function",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "function"
            ],
            "title": "_NamedToolChoice",
            "type": "object"
          },
          "_TextContentPart": {
            "additionalProperties": false,
            "description": "An OpenAI ``text`` content part. ``text`` is rendered through the same ``$in`` template\nlanguage as a plain-string ``content`` (so a part can still compose an upstream value).",
            "properties": {
              "text": {
                "title": "Text",
                "type": "string"
              },
              "type": {
                "const": "text",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "title": "_TextContentPart",
            "type": "object"
          },
          "_ToolFunctionName": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "title": "_ToolFunctionName",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "``llm`` node config. ``model`` names a key in\n``IRDocument.models``; ``messages`` is the prompt template \u2014 content fields use the ONE\nport-addressed substitution token language shared with ``tool``/``mcp_tool``/``router``\n(\u00a78.5 / m10.md \u00a71.2): ``$in`` is the default in-port ``in``, ``$in.<port>`` selects a named\nin-port (so one node composes multiple upstreams), ``$in.<port>.<field>`` drills in. An unknown\nport or token fails loudly, never silent literal pass-through. (``$input`` was the M5 spelling,\nrenamed to ``$in`` in M9; M10 made the segment after ``$in.`` a port name \u2014 see m10.md.)\n\nM20 cross-plane follow-up: a message ``content`` may be a list of OpenAI content parts (text +\nimage_url), not only a string, so a graph can drive a vision model (mlx_vlm on\n``/v1/chat/completions``). The ``$in`` grammar applies inside each text part and each image url,\nso an image enters from an in-port (``$in.image``); a plain-string ``content`` is unchanged and\nhashes identically (see ``_Message``).",
        "properties": {
          "maxToolIterations": {
            "default": 8,
            "title": "Maxtooliterations",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/$defs/_Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "toolChoice": {
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "none",
                  "required"
                ],
                "type": "string"
              },
              {
                "$ref": "#/$defs/_NamedToolChoice"
              }
            ],
            "default": "auto",
            "title": "Toolchoice"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "LlmConfig",
        "type": "object"
      },
      "defaultConfig": {
        "maxToolIterations": 8,
        "messages": [],
        "model": "",
        "toolChoice": "auto",
        "tools": []
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          },
          {
            "id": "tools",
            "required": false,
            "role": "tool",
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "llm"
    },
    "loop": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``loop`` orchestration node config (m14.md \u00a71.3) \u2014 bounded, deterministic agentic repetition\n(think\u2192act\u2192observe). Each iteration runs the pinned ``agent`` (a SAVED agent, child workflow);\nthe previous iteration's output feeds the next as input. ``max_iterations`` is **REQUIRED** (no\nunbounded loops \u2014 the termination + determinism guarantee). ``condition`` (optional) is a\n``$in``-reference over the iteration output (the same port-addressed grammar the router uses \u2014\nm14.md \u00a71.3 \"reuse the router expression evaluator\"): the loop **stops early** when it resolves\ntruthy. The loop control is deterministic orchestration with NO I/O \u2014 it reads journaled child\nresults, never calls inference, so a crash mid-loop resumes at the last completed iteration (no\ncompleted iteration re-runs). ``max_depth`` bounds nesting as in ``subgraph``.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Condition"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "maxIterations": {
            "title": "Maxiterations",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent",
          "maxIterations"
        ],
        "title": "LoopConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "condition": null,
        "contentHash": null,
        "maxDepth": 8,
        "maxIterations": 0,
        "version": null
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "loop"
    },
    "map": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``map`` orchestration node config (m14.md \u00a71.4) \u2014 durable fan-out/join over a collection. The\nin-port value must be a list; one task (the pinned ``agent`` run as a child workflow) is\nenqueued on a DBOS durable queue per element, then all results are durably awaited \u2014 so a crash\nmid-fan-out resumes ONLY the incomplete branches. ``concurrency`` bounds how many branches are\nin flight at once (``None`` = unbounded). ``on_error`` is the partial-failure policy:\n``fail_fast`` (default \u2014 any element error fails the map) vs ``collect`` (gather successes +\nper-element errors). ``max_depth`` bounds nesting as in ``subgraph``.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "concurrency": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Concurrency"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "onError": {
            "default": "fail_fast",
            "enum": [
              "fail_fast",
              "collect"
            ],
            "title": "Onerror",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent"
        ],
        "title": "MapConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "concurrency": null,
        "contentHash": null,
        "maxDepth": 8,
        "onError": "fail_fast",
        "version": null
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "map"
    },
    "mcp_tool": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``mcp_tool`` activity node config (\u00a78.5 / m7.md \u00a72 + M19 \u00a72.4). The server is reached EITHER\nby the M7 ``server`` (the **logical name** of a registered MCP server, resolved by the manager)\nOR \u2014 M19 \u2014 by a ``connection`` id (an ``mcp_server`` connection, stdio or http, whose auth is\nresolved SERVER-SIDE at step time \u2014 the IR carries no secret, \u00a71.1). EXACTLY ONE of\n``server`` / ``connection`` is set (validated below). ``tool`` is the tool that server exposes;\n``args`` is the same ``$in`` / ``$in.a.b`` arg template as M6's ``tool`` \u2014 the IR seam matches a\nlocal tool, only the transport differs.",
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "connection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "server": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Server"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "title": "McpToolConfig",
        "type": "object"
      },
      "defaultConfig": {
        "args": {},
        "connection": null,
        "description": null,
        "server": null,
        "tool": ""
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          },
          {
            "id": "use",
            "role": "tool",
            "type": "any"
          }
        ]
      },
      "type": "mcp_tool"
    },
    "output": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``output`` boundary node \u2014 the run's return value (M19 \u00a72.1, made real). ``modality`` is the\nresult shape (text default); for audio/image it is a REFERENCE to the artifact a ``speak``/tool\nproduced upstream. ``output`` performs NO side effect (\u00a70) \u2014 posting/sending is a tool step.",
        "properties": {
          "modality": {
            "default": "text",
            "enum": [
              "text",
              "audio",
              "image",
              "json"
            ],
            "title": "Modality",
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema"
          }
        },
        "title": "OutputConfig",
        "type": "object"
      },
      "defaultConfig": {
        "modality": "text",
        "schema": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": []
      },
      "type": "output"
    },
    "quota": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``quota`` activity node config (m19.md \u00a72.8/\u00a71.6) \u2014 a token-budget gate that READS\naccumulated usage, never re-meters (\u00a71.6). ``source: \"spans\"`` rolls up the per-node token\ncounts already on M17 spans; denies past ``budget_tokens`` in ``window_seconds`` per key.\nBuilds NO new metering pipeline (the \u00a78 Do-NOT).",
        "properties": {
          "budgetTokens": {
            "title": "Budgettokens",
            "type": "integer"
          },
          "keyExpr": {
            "title": "Keyexpr",
            "type": "string"
          },
          "source": {
            "const": "spans",
            "default": "spans",
            "title": "Source",
            "type": "string"
          },
          "windowSeconds": {
            "title": "Windowseconds",
            "type": "integer"
          }
        },
        "required": [
          "keyExpr",
          "budgetTokens",
          "windowSeconds"
        ],
        "title": "QuotaConfig",
        "type": "object"
      },
      "defaultConfig": {
        "budgetTokens": 0,
        "keyExpr": "",
        "source": "spans",
        "windowSeconds": 0
      },

        "keyExpr": "",
        "source": "spans",
        "windowSeconds": 0
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "allow",
            "type": "any"
          },
          {
            "id": "deny",
            "type": "any"
          }
        ]
      },
      "type": "quota"
    },
    "ratelimit": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``ratelimit`` activity node config \u2014 the lean per-key gate seam. ``key_expr`` resolves the\ncaller key from a trigger token / webhook signature or a ``$in`` field. Denies past ``limit``\nrequests in ``window_seconds`` per key, backed by a trivial Postgres counter. ``policy: \"deny\"``\nemits the ``deny`` port (a clean 429-style result); ``policy: \"wait\"`` (a bounded suspend) is\nNAMED but not yet built \u2014 start with deny.",
        "properties": {
          "keyExpr": {
            "title": "Keyexpr",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "policy": {
            "default": "deny",
            "enum": [
              "deny",
              "wait"
            ],
            "title": "Policy",
            "type": "string"
          },
          "windowSeconds": {
            "title": "Windowseconds",
            "type": "integer"
          }
        },
        "required": [
          "keyExpr",
          "limit",
          "windowSeconds"
        ],
        "title": "RateLimitConfig",
        "type": "object"
      },
      "defaultConfig": {
        "keyExpr": "",
        "limit": 0,
        "policy": "deny",
        "windowSeconds": 0
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "allow",
            "type": "any"
          },
          {
            "id": "deny",
            "type": "any"
          }
        ]
      },
      "type": "ratelimit"
    },
    "router": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``router`` orchestration node config. ``select`` is a ``$in``-reference that must resolve\nto the **name of one of this node's outgoing handles** \u2014 handle-name routing, not an expression\nDSL. The walker follows only the edge(s) from the selected handle.",
        "properties": {
          "select": {
            "title": "Select",
            "type": "string"
          }
        },
        "required": [
          "select"
        ],
        "title": "RouterConfig",
        "type": "object"
      },
      "defaultConfig": {
        "select": ""
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "router"
    },
    "speak": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``speak`` activity node config \u2014 text in \u2192 audio-ref out, mapping 1:1 to\n``POST /v1/audio/speech``. ``model`` names a ``models`` key whose binding advertises the\n``audio.speech`` modality; ``params`` carries ``voice``/``format``/``speed``. The step's\nreturn value is a REFERENCE to the produced audio (bytes are an artifact, never journaled); it\nfeeds an ``output`` (``modality:audio``) or an action ``tool``.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "model"
        ],
        "title": "SpeakConfig",
        "type": "object"
      },
      "defaultConfig": {
        "model": "",
        "params": {}
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "text",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "audio",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          }
        ]
      },
      "type": "speak"
    },
    "subgraph": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``subgraph`` boundary node config \u2014 an agent calls another SAVED agent, run as a DBOS child\nworkflow (independently durable + resumable). ``agent`` is the child's IR id; the node pins it\nwith EXACTLY ONE of ``version`` / ``content_hash`` (validated in ``validate_graph``) and the\npin is frozen into the parent's contentHash, so composition is immutable. ``max_depth`` bounds\nrecursion: exceeding it fails honestly, preventing unbounded / mutually-recursive expansion.\nThe parent's in-port value is the child's run input (named ports); the child's output binds\nthe node's success handle.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent"
        ],
        "title": "SubgraphConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "contentHash": null,
        "maxDepth": 8,
        "version": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          }
        ]
      },
      "type": "subgraph"
    },
    "tool": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``tool`` activity node config. ``tool`` is a logical name: a key in ``ir.tools`` (an ``http``\nconnection-backed binding or a ``builtin``) OR a directly-registered builtin\n(``echo``/``http_fetch``). Membership is checked in the control plane, not here\n(``packages/ir`` stays pure).\n\nBuiltin path: ``args`` is the arg template \u2014 each value a literal or a ``$in``-reference\n(``$in`` = the whole in-port value, ``$in.a.b`` = a path into it) resolved before the call.\n\nHttp path (when ``tool`` resolves to an ``http`` binding): the request is described by the\nadditive fields below, all optional so a builtin ``tool`` node is byte-identical. The connection\n(resolved from ``ir.tools[tool].connection``) injects auth headers SERVER-SIDE \u2014 auth never\nappears in the IR or the rendered template. ``url_template``/``headers``/``body_template`` use\nthe unified ``$in.field`` substitution; ``response_map`` is an optional JSONPath to shape the\nstep output; ``idempotency_key`` (set for unsafe methods) makes a partial-failure re-run a\nprovider no-op.",
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "bodyTemplate": {
            "default": null,
            "title": "Bodytemplate"
          },
          "connection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "idempotencyKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Idempotencykey"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "parameterSchema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Parameterschema"
          },
          "responseMap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Responsemap"
          },
          "timeoutSeconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeoutseconds"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "urlTemplate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Urltemplate"
          }
        },
        "required": [
          "tool"
        ],
        "title": "ToolConfig",
        "type": "object"
      },
      "defaultConfig": {
        "args": {},
        "bodyTemplate": null,
        "connection": null,
        "description": null,
        "headers": {},
        "idempotencyKey": null,
        "method": null,
        "parameterSchema": null,
        "responseMap": null,
        "timeoutSeconds": null,
        "tool": "",
        "urlTemplate": null
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          },
          {
            "id": "use",
            "role": "tool",
            "type": "any"
          }
        ]
      },
      "type": "tool"
    },
    "transcribe": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``transcribe`` activity node config \u2014 audio-ref in \u2192 text out, mapping 1:1 to\n``POST /v1/audio/transcriptions``. ``model`` names a key in ``IRDocument.models`` whose\nbinding's ``capabilities.modalities`` must include ``audio.transcription`` (data-driven \u2014 an\nincompatible binding is rejected at run, not silently); ``params`` (language/prompt/\u2026) ride\nthrough to the endpoint. The audio bytes go to the inference base URL in the user's trust\ndomain, never the control plane.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"

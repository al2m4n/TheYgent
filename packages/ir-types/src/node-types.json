{
  "types": {
    "guardrail": {
      "configSchema": {
        "$defs": {
          "GuardrailCheck": {
            "additionalProperties": false,
            "description": "The guardrail's check. ``type`` picks the backend: ``rule`` (deterministic,\n\u21d2orchestration) or ``model`` (a classifier call, \u21d2activity). Exactly the matching sub-config\nis set; the node's ``kind`` follows the backend and is validated against it.",
            "properties": {
              "model": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GuardrailModel"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "rule": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GuardrailRule"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "type": {
                "enum": [
                  "rule",
                  "model"
                ],
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "title": "GuardrailCheck",
            "type": "object"
          },
          "GuardrailModel": {
            "additionalProperties": false,
            "description": "A model guardrail check backend (``check.type == \"model\"``) \u2014 an LLM-judge \"is this in\nscope?\" classifier. ``model`` names a ``models`` key (a real data-plane call, so a model\nguardrail is ``kind: activity``); ``prompt`` is the judge question; ``pass_on`` is the model\nanswer that PASSES (default ``\"yes\"``) \u2014 anything else routes to ``block``.",
            "properties": {
              "model": {
                "title": "Model",
                "type": "string"
              },
              "passOn": {
                "default": "yes",
                "title": "Passon",
                "type": "string"
              },
              "prompt": {
                "title": "Prompt",
                "type": "string"
              }
            },
            "required": [
              "model",
              "prompt"
            ],
            "title": "GuardrailModel",
            "type": "object"
          },
          "GuardrailRule": {
            "additionalProperties": false,
            "description": "A deterministic guardrail check backend (``check.type == \"rule\"``). ``kind`` selects the\npredicate; ``spec`` carries its knob (the regex, the min/max length, the json schema, the\nallow/deny list, the PII pattern set). Evaluated INLINE over journaled input \u2014 no I/O, no\nlatency \u2014 so a rule guardrail is ``kind: orchestration``.",
            "properties": {
              "kind": {
                "enum": [
                  "regex",
                  "length",
                  "json_schema",
                  "allow",
                  "deny",
                  "pii"
                ],
                "title": "Kind",
                "type": "string"
              },
              "spec": {
                "additionalProperties": true,
                "title": "Spec",
                "type": "object"
              }
            },
            "required": [
              "kind"
            ],
            "title": "GuardrailRule",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "``guardrail`` node config \u2014 a first-class check that short-circuits before downstream work.\n``pass`` carries the input through; ``block`` carries the ``on_block`` payload (or the\nviolation) \u2014 wire it to an ``output`` to refuse BEFORE the expensive node. ``kind`` is\nper-instance: the editor stamps ``orchestration`` for a rule check, ``activity`` for a model\ncheck, and ``validate_graph`` enforces the match.",
        "properties": {
          "check": {
            "$ref": "#/$defs/GuardrailCheck"
          },
          "onBlock": {
            "additionalProperties": true,
            "title": "Onblock",
            "type": "object"
          }
        },
        "required": [
          "check"
        ],
        "title": "GuardrailConfig",
        "type": "object"
      },
      "defaultConfig": {
        "check": null,
        "onBlock": {}
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "pass",
            "type": "any"
          },
          {
            "id": "block",
            "type": "any"
          }
        ]
      },
      "type": "guardrail"
    },
    "human": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``human`` boundary node config \u2014 a durable wait for external input. The node lowers onto\n``DBOS.recv``: the run persists as ``waiting`` and survives a worker crash while paused;\n``POST /runs/{id}/resume`` (\u2192 ``DBOS.send``) delivers the awaited input and the workflow\nresumes from the checkpoint. ``prompt`` describes what input is expected (advisory);\n``input_schema`` is the awaited input's declared shape (advisory \u2014 resume records it, doesn't\nenforce a full JSON-Schema validation). ``timeout`` (seconds; ``None`` = wait forever) bounds\nthe wait; on timeout the node fails honestly (``on_timeout='fail'``, the default \u2192 ``failed``\nrun) or binds the declared ``default`` (``on_timeout='default'``).",
        "properties": {
          "default": {
            "default": null,
            "title": "Default"
          },
          "inputSchema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inputschema"
          },
          "onTimeout": {
            "default": "fail",
            "enum": [
              "fail",
              "default"
            ],
            "title": "Ontimeout",
            "type": "string"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prompt"
          },
          "timeout": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout"
          }
        },
        "title": "HumanConfig",
        "type": "object"
      },
      "defaultConfig": {
        "default": null,
        "inputSchema": null,
        "onTimeout": "fail",
        "prompt": null,
        "timeout": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "human"
    },
    "imagine": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``imagine`` activity node config \u2014 text in \u2192 image-ref out, mapping 1:1 to\n``POST /v1/images/generations``. The image analog of ``speak``: ``model`` names a ``models``\nkey whose binding advertises the ``images.generation`` modality; ``params`` carries\n``size``/``n``/``steps``. The step's return value is a REFERENCE to the produced image (bytes\nare an artifact, never journaled); it feeds an ``output`` (``modality:image``) or an action\n``tool``.",
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "params": {
            "additionalProperties": true,
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "model"
        ],
        "title": "ImagineConfig",
        "type": "object"
      },
      "defaultConfig": {
        "model": "",
        "params": {}
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "imagine"
    },
    "input": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``input`` boundary node \u2014 the single typed entry. ``modality`` declares the payload shape\n(text by default); ``schema`` is the JSON Schema of the expected payload that triggers map\ntheir source onto. Both are declarative \u2014 the walker still binds the run input to the out-port;\nmodality/schema drive the editor + trigger mapping, not execution.",
        "properties": {
          "modality": {
            "default": "text",
            "enum": [
              "text",
              "audio",
              "image",
              "video",
              "json",
              "file"
            ],
            "title": "Modality",
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema"
          }
        },
        "title": "InputConfig",
        "type": "object"
      },
      "defaultConfig": {
        "modality": "text",
        "schema": null
      },
      "kind": "boundary",
      "ports": {
        "in": [],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "input"
    },
    "llm": {
      "configSchema": {
        "$defs": {
          "_ImageContentPart": {
            "additionalProperties": false,
            "description": "An OpenAI ``image_url`` content part \u2014 the block that carries a vision input.",
            "properties": {
              "imageUrl": {
                "$ref": "#/$defs/_ImageUrl"
              },
              "type": {
                "const": "image_url",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "imageUrl"
            ],
            "title": "_ImageContentPart",
            "type": "object"
          },
          "_ImageUrl": {
            "additionalProperties": false,
            "description": "The ``image_url`` payload of an image content part (OpenAI shape). ``url`` is an http(s) URL\nor a ``data:`` URI (base64-inline); it is ``$in``-templatable so the image can come from a graph\nin-port. ``detail`` is OpenAI's optional fidelity hint (``low``/``high``/``auto``).",
            "properties": {
              "detail": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Detail"
              },
              "url": {
                "title": "Url",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "title": "_ImageUrl",
            "type": "object"
          },
          "_Message": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "discriminator": {
                        "mapping": {
                          "image_url": "#/$defs/_ImageContentPart",
                          "text": "#/$defs/_TextContentPart"
                        },
                        "propertyName": "type"
                      },
                      "oneOf": [
                        {
                          "$ref": "#/$defs/_TextContentPart"
                        },
                        {
                          "$ref": "#/$defs/_ImageContentPart"
                        }
                      ]
                    },
                    "type": "array"
                  }
                ],
                "title": "Content"
              },
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ],
                "title": "Role",
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ],
            "title": "_Message",
            "type": "object"
          },
          "_NamedToolChoice": {
            "additionalProperties": false,
            "description": "Force a specific tool \u2014 OpenAI's ``{\"type\":\"function\",\"function\":{\"name\":...}}``.",
            "properties": {
              "function": {
                "$ref": "#/$defs/_ToolFunctionName"
              },
              "type": {
                "const": "function",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "function"
            ],
            "title": "_NamedToolChoice",
            "type": "object"
          },
          "_TextContentPart": {
            "additionalProperties": false,
            "description": "An OpenAI ``text`` content part. ``text`` is rendered through the same ``$in`` template\nlanguage as a plain-string ``content`` (so a part can still compose an upstream value).",
            "properties": {
              "text": {
                "title": "Text",
                "type": "string"
              },
              "type": {
                "const": "text",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "text"
            ],
            "title": "_TextContentPart",
            "type": "object"
          },
          "_ToolFunctionName": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "title": "_ToolFunctionName",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "``llm`` node config. ``model`` names a key in ``IRDocument.models``; ``messages`` is the\nprompt template \u2014 content fields use the port-addressed substitution token language shared with\n``tool``/``mcp_tool``/``router``: ``$in`` is the default in-port ``in``, ``$in.<port>`` selects\na named in-port (so one node composes multiple upstreams), ``$in.<port>.<field>`` drills in. An\nunknown port or token fails loudly, never silent literal pass-through. (``$input`` was the\noriginal spelling, renamed to ``$in``; the segment after ``$in.`` is a port name.)\n\nA message ``content`` may be a list of OpenAI content parts (text + image_url), not only a\nstring, so a graph can drive a vision model (on ``/v1/chat/completions``). The ``$in`` grammar\napplies inside each text part and each image url, so an image enters from an in-port\n(``$in.image``); a plain-string ``content`` is unchanged and hashes identically (see\n``_Message``).",
        "properties": {
          "maxToolIterations": {
            "default": 8,
            "title": "Maxtooliterations",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/$defs/_Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "toolChoice": {
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "none",
                  "required"
                ],
                "type": "string"
              },
              {
                "$ref": "#/$defs/_NamedToolChoice"
              }
            ],
            "default": "auto",
            "title": "Toolchoice"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "title": "LlmConfig",
        "type": "object"
      },
      "defaultConfig": {
        "maxToolIterations": 8,
        "messages": [],
        "model": "",
        "toolChoice": "auto",
        "tools": []
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          },
          {
            "id": "tools",
            "required": false,
            "role": "tool",
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "llm"
    },
    "loop": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``loop`` orchestration node config \u2014 bounded, deterministic agentic repetition\n(think\u2192act\u2192observe). Each iteration runs the pinned ``agent`` (a SAVED agent, child workflow);\nthe previous iteration's output feeds the next as input. ``max_iterations`` is **REQUIRED** (no\nunbounded loops \u2014 the termination + determinism guarantee). ``condition`` (optional) is a\n``$in``-reference over the iteration output (the same port-addressed grammar the router uses):\nthe loop **stops early** when it resolves truthy. The loop control is deterministic\norchestration with NO I/O \u2014 it reads journaled child results, never calls inference, so a crash\nmid-loop resumes at the last completed iteration (no completed iteration re-runs). ``max_depth``\nbounds nesting as in ``subgraph``.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "condition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Condition"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "maxIterations": {
            "title": "Maxiterations",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent",
          "maxIterations"
        ],
        "title": "LoopConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "condition": null,
        "contentHash": null,
        "maxDepth": 8,
        "maxIterations": 0,
        "version": null
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "loop"
    },
    "map": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``map`` orchestration node config \u2014 durable fan-out/join over a collection. The in-port\nvalue must be a list; one task (the pinned ``agent`` run as a child workflow) is enqueued on a\nDBOS durable queue per element, then all results are durably awaited \u2014 so a crash mid-fan-out\nresumes ONLY the incomplete branches. ``concurrency`` bounds how many branches are in flight at\nonce (``None`` = unbounded). ``on_error`` is the partial-failure policy: ``fail_fast`` (default\n\u2014 any element error fails the map) vs ``collect`` (gather successes + per-element errors).\n``max_depth`` bounds nesting as in ``subgraph``.",
        "properties": {
          "agent": {
            "title": "Agent",
            "type": "string"
          },
          "concurrency": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Concurrency"
          },
          "contentHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contenthash"
          },
          "maxDepth": {
            "default": 8,
            "title": "Maxdepth",
            "type": "integer"
          },
          "onError": {
            "default": "fail_fast",
            "enum": [
              "fail_fast",
              "collect"
            ],
            "title": "Onerror",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          }
        },
        "required": [
          "agent"
        ],
        "title": "MapConfig",
        "type": "object"
      },
      "defaultConfig": {
        "agent": "",
        "concurrency": null,
        "contentHash": null,
        "maxDepth": 8,
        "onError": "fail_fast",
        "version": null
      },
      "kind": "orchestration",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          }
        ]
      },
      "type": "map"
    },
    "mcp_tool": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``mcp_tool`` activity node config. The server is reached EITHER by the ``server`` name (the\n**logical name** of a registered MCP server, resolved by the manager) OR by a ``connection`` id\n(an ``mcp_server`` connection, stdio or http, whose auth is resolved SERVER-SIDE at step time \u2014\nthe IR carries no secret). EXACTLY ONE of ``server`` / ``connection`` is set (validated below).\n``tool`` is the tool that server exposes; ``args`` is the same ``$in`` / ``$in.a.b`` arg\ntemplate as a ``tool`` node \u2014 the IR seam matches a local tool, only the transport differs.",
        "properties": {
          "args": {
            "additionalProperties": true,
            "title": "Args",
            "type": "object"
          },
          "connection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "server": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Server"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "title": "McpToolConfig",
        "type": "object"
      },
      "defaultConfig": {
        "args": {},
        "connection": null,
        "description": null,
        "server": null,
        "tool": ""
      },
      "kind": "activity",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": [
          {
            "id": "out",
            "type": "any"
          },
          {
            "id": "err",
            "type": "error"
          },
          {
            "id": "use",
            "role": "tool",
            "type": "any"
          }
        ]
      },
      "type": "mcp_tool"
    },
    "output": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``output`` boundary node \u2014 the run's return value. ``modality`` is the result shape (text\ndefault); for audio/image it is a REFERENCE to the artifact a ``speak``/tool produced upstream.\n``output`` performs NO side effect \u2014 posting/sending is a tool step.",
        "properties": {
          "modality": {
            "default": "text",
            "enum": [
              "text",
              "audio",
              "image",
              "json"
            ],
            "title": "Modality",
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema"
          }
        },
        "title": "OutputConfig",
        "type": "object"
      },
      "defaultConfig": {
        "modality": "text",
        "schema": null
      },
      "kind": "boundary",
      "ports": {
        "in": [
          {
            "id": "in",
            "required": true,
            "type": "any"
          }
        ],
        "out": []
      },
      "type": "output"
    },
    "quota": {
      "configSchema": {
        "additionalProperties": false,
        "description": "``quota`` activity node config \u2014 a token-budget gate that READS accumulated usage, never\nre-meters. ``source: \"spans\"`` rolls up the per-node token counts already on existing spans;\ndenies past ``budget_tokens`` in ``window_seconds`` per key. Builds NO new metering pipeline.",
        "properties": {
          "budgetTokens": {
            "title": "Budgettokens",
            "type": "integer"
          },
          "keyExpr": {
            "title": "Keyexpr",
            "type": "string"
          },
          "source": {
            "const": "spans",
            "default": "spans",
            "title": "Source",
            "type": "string"
          },
          "windowSeconds": {
            "title": "Windowseconds",
            "type": "integer"
          }
        },
        "required": [
          "keyExpr",
          "budgetTokens",
          "windowSeconds"
        ],
        "title": "QuotaConfig",
        "type": "object"
      },
      "defaultConfig": {

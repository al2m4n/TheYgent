{
  "$defs": {
    "BuiltinTool": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "builtin",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "BuiltinTool",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A directed connection (\u00a78.3). ``channel: data`` passes a value along the edge;\n``channel: control`` is pure sequencing. ``condition`` is reserved for router-driven\nedges (the first ``orchestration`` node, deferred \u2014 M5 \u00a77).",
      "properties": {
        "channel": {
          "default": "data",
          "enum": [
            "data",
            "control",
            "tool"
          ],
          "title": "Channel",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sourceHandle": {
          "title": "Sourcehandle",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "targetHandle": {
          "title": "Targethandle",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "sourceHandle",
        "target",
        "targetHandle"
      ],
      "title": "Edge",
      "type": "object"
    },
    "HttpTool": {
      "additionalProperties": false,
      "description": "An http/REST/GraphQL tool binding (M19 \u00a72.3) \u2014 the workhorse + the substrate for action tools\n(\u00a72.5) and crawler tools (\u00a71.4). ``connection`` is the id of an ``http_auth`` connection (M19\n\u00a71.1) whose secret the handler injects SERVER-SIDE at step time \u2014 never inline in the IR. The\noptional ``template`` names a provider request shape (e.g. ``slack.chat.postMessage``) for the\nsmall built-in action set; everything else is the raw http tool config on the node (\u00a72.3).",
      "properties": {
        "bodyTemplate": {
          "default": null,
          "title": "Bodytemplate"
        },
        "connection": {
          "title": "Connection",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotencykey"
        },
        "kind": {
          "const": "http",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "parameterSchema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameterschema"
        },
        "responseMap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Responsemap"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutseconds"
        },
        "urlTemplate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urltemplate"
        }
      },
      "required": [
        "kind",
        "connection"
      ],
      "title": "HttpTool",
      "type": "object"
    },
    "McpTool": {
      "additionalProperties": false,
      "description": "An MCP tool binding (M7 + M19 \u00a72.4). ``tool`` is the named tool the server exposes; the\nserver is reached EITHER by the M7 ``server`` name (a registered ``mcp_server``) OR \u2014 M19 \u2014 by a\n``connection`` id (an ``mcp_server`` connection, stdio or http, auth via its secret_ref).\nExactly one of ``server`` / ``connection`` is set (validated below); no secret in the IR.",
      "properties": {
        "connection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection"
        },
        "kind": {
          "const": "mcp",
          "title": "Kind",
          "type": "string"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool"
      ],
      "title": "McpTool",
      "type": "object"
    },
    "ModelBinding": {
      "additionalProperties": false,
      "description": "A logical model the graph's nodes reference by key (\u00a78.4) \u2014 the sovereignty dial.\n\nNodes never hardcode a provider; they name a key in ``IRDocument.models`` and the\n``binding`` resolves at runtime through the L0 gateway. ``binding`` names only the engines\ntheygent manages (``mlx``/``vllm``/``llamacpp``) plus the catch-all ``openai-compatible``;\n``source`` (where the *weights* come from) is orthogonal and never an engine.\n\n``model`` is the id forwarded to the inference seam. M5 has no registry/lifecycle manager\n(M5 \u00a77), so the walker forwards ``model`` as the logical id the inference plane already\nknows (the \u00a79.1.1 logical-id invariant still holds \u2014 an engine name here is rejected at\nthe seam). ``source`` is optional: it answers a lifecycle question (fetch the weights from\nwhere?) that only matters once theygent manages the engine, which M5 does not \u2014 so the\ntrivial M5 graph omits it, while a \u00a78.4 document that includes it still validates.",
      "properties": {
        "binding": {
          "enum": [
            "mlx",
            "vllm",
            "llamacpp",
            "openai-compatible"
          ],
          "title": "Binding",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "hf",
                "local-path",
                "url"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "binding",
        "model"
      ],
      "title": "ModelBinding",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "One graph node (\u00a78.3). ``id`` is stable \u2014 it is what an OTel span binds to later\n(M5 stamps it on per-node logs, the attach-point). ``config`` is ``type``-specific and\nvalidated against a per-``type`` schema in ``validate_graph`` \u2014 Pydantic at the boundary,\nnot a free-form dict the walker trusts blindly.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "activity",
            "orchestration",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "ports": {
          "$ref": "#/$defs/Ports"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "kind"
      ],
      "title": "Node",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "description": "A declared (not inferred) connection point, so the compiler can type-check edges\n(\u00a78.3). ``type`` is advisory in M5 (``any``/``error``); real port typing lands with the\nnode types that need it.\n\n``required`` is meaningful for **in**-ports (M10 \u00a73): a required in-port must be fed by a\n``data`` edge or the graph fails validation; ``required: false`` declares an in-port that may\nbe left unfed and resolves to ``null`` at runtime. The default is required, so an unfed input\nis a loud validation error rather than a silent ``None`` \u2014 the multi-input analogue of M9's\nno-silent-pass-through rule. (Ignored on out-ports.)\n\n``role`` (M19 \u00a72.10) is the channel a handle carries: ``data`` (the default \u2014 threads a value)\nor ``control`` (pure ordering: \"run after this passes\", no value). The editor renders the two\ndistinctly and only allows data\u2192data / control\u2192control connections; an edge's ``channel`` is\nDERIVED from the handles it joins, not a separate toggle. The walker/compiler dispatch by edge\n``channel`` exactly as before \u2014 ``role`` is the per-handle declaration the channel follows, so a\npre-M19 IR (all ports default ``data``) is unchanged in meaning. This is the ONLY IR-shape\naddition in M19 (\u00a70/\u00a75).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "default": "data",
          "enum": [
            "data",
            "control",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "type": {
          "default": "any",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Port",
      "type": "object"
    },
    "Ports": {
      "additionalProperties": false,
      "properties": {
        "in": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "In",
          "type": "array"
        },
        "out": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Out",
          "type": "array"
        }
      },
      "title": "Ports",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A saved agent \u2014 one JSON document (\u00a78.2). ``id`` + ``version`` is the registry\ncoordinate; ``content_hash`` (computed over the view-stripped graph) gives content-addressed\ndeploys. ``view`` is the React-Flow layer and is **never** hashed (\u00a78.6).",
  "properties": {
    "contentHash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contenthash"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelBinding"
      },
      "title": "Models",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schemaVersion": {
      "title": "Schemaversion",
      "type": "string"
    },
    "tools": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "builtin": "#/$defs/BuiltinTool",
            "http": "#/$defs/HttpTool",
            "mcp": "#/$defs/McpTool"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BuiltinTool"
          },
          {
            "$ref": "#/$defs/HttpTool"
          },
          {
            "$ref": "#/$defs/McpTool"
          }
        ]
      },
      "title": "Tools",
      "type": "object"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "view": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "View"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "title": "IRDocument",
  "type": "object"
}

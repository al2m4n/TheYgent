{
  "$defs": {
    "BuiltinTool": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "builtin",
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "BuiltinTool",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A directed connection. ``channel: data`` passes a value along the edge;\n``channel: control`` is pure sequencing. ``condition`` is reserved for router-driven\nedges.",
      "properties": {
        "channel": {
          "default": "data",
          "enum": [
            "data",
            "control",
            "tool"
          ],
          "title": "Channel",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "sourceHandle": {
          "title": "Sourcehandle",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "targetHandle": {
          "title": "Targethandle",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "sourceHandle",
        "target",
        "targetHandle"
      ],
      "title": "Edge",
      "type": "object"
    },
    "HttpTool": {
      "additionalProperties": false,
      "description": "An http/REST/GraphQL tool binding \u2014 the workhorse + the substrate for action tools\nand crawler tools. ``connection`` is the id of an ``http_auth`` connection whose secret the\nhandler injects SERVER-SIDE at step time \u2014 never inline in the IR. The optional ``template``\nnames a provider request shape (e.g. ``slack.chat.postMessage``) for the small built-in action\nset; everything else is the raw http tool config on the node.",
      "properties": {
        "bodyTemplate": {
          "default": null,
          "title": "Bodytemplate"
        },
        "connection": {
          "title": "Connection",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotencykey"
        },
        "kind": {
          "const": "http",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "parameterSchema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameterschema"
        },
        "responseMap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Responsemap"
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        },
        "timeoutSeconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeoutseconds"
        },
        "urlTemplate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urltemplate"
        }
      },
      "required": [
        "kind",
        "connection"
      ],
      "title": "HttpTool",
      "type": "object"
    },
    "McpTool": {
      "additionalProperties": false,
      "description": "An MCP tool binding. ``tool`` is the named tool the server exposes; the server is reached\nEITHER by the ``server`` name (a registered ``mcp_server``) OR by a ``connection`` id (an\n``mcp_server`` connection, stdio or http, auth via its secret_ref). Exactly one of\n``server`` / ``connection`` is set (validated below); no secret in the IR.",
      "properties": {
        "connection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection"
        },
        "kind": {
          "const": "mcp",
          "title": "Kind",
          "type": "string"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool"
      ],
      "title": "McpTool",
      "type": "object"
    },
    "ModelBinding": {
      "additionalProperties": false,
      "description": "A logical model the graph's nodes reference by key \u2014 the sovereignty dial.\n\nNodes never hardcode a provider; they name a key in ``IRDocument.models`` and the\n``binding`` resolves at runtime through the L0 gateway. ``binding`` names only the engines\ntheygent manages (``mlx``/``vllm``/``llamacpp``) plus the catch-all ``openai-compatible``;\n``source`` (where the *weights* come from) is orthogonal and never an engine.\n\n``model`` is the id forwarded to the inference seam. The walker forwards ``model`` as the\nlogical id the inference plane already knows (the logical-id invariant holds \u2014 an engine\nname here is rejected at the seam). ``source`` is optional: it answers a lifecycle question\n(fetch the weights from where?) that only matters once theygent manages the engine.",
      "properties": {
        "binding": {
          "enum": [
            "mlx",
            "vllm",
            "llamacpp",
            "openai-compatible"
          ],
          "title": "Binding",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "hf",
                "local-path",
                "url"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "binding",
        "model"
      ],
      "title": "ModelBinding",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "One graph node. ``id`` is stable \u2014 it is what an OTel span binds to later\n(stamped on per-node logs as the attach-point). ``config`` is ``type``-specific and\nvalidated against a per-``type`` schema in ``validate_graph`` \u2014 Pydantic at the boundary,\nnot a free-form dict the walker trusts blindly.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "activity",
            "orchestration",
            "boundary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "ports": {
          "$ref": "#/$defs/Ports"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "kind"
      ],
      "title": "Node",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "description": "A declared (not inferred) connection point, so the compiler can type-check edges.\n``type`` is advisory (``any``/``error``); real port typing lands with the node types\nthat need it.\n\n``required`` is meaningful for **in**-ports: a required in-port must be fed by a ``data`` edge\nor the graph fails validation; ``required: false`` declares an in-port that may be left unfed\nand resolves to ``null`` at runtime. The default is required, so an unfed input is a loud\nvalidation error rather than a silent ``None`` \u2014 the multi-input analogue of the\nno-silent-pass-through rule. (Ignored on out-ports.)\n\n``role`` is the channel a handle carries: ``data`` (the default \u2014 threads a value) or\n``control`` (pure ordering: \"run after this passes\", no value). The editor renders the two\ndistinctly and only allows data\u2192data / control\u2192control connections; an edge's ``channel`` is\nDERIVED from the handles it joins, not a separate toggle. The walker/compiler dispatch by edge\n``channel`` exactly as before \u2014 ``role`` is the per-handle declaration the channel follows, so a\nport that omits ``role`` defaults to ``data`` and is unchanged in meaning.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "default": "data",
          "enum": [
            "data",
            "control",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "type": {
          "default": "any",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Port",
      "type": "object"
    },
    "Ports": {
      "additionalProperties": false,
      "properties": {
        "in": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "In",
          "type": "array"
        },
        "out": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Out",
          "type": "array"
        }
      },
      "title": "Ports",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A saved agent \u2014 one JSON document. ``id`` + ``version`` is the registry coordinate;\n``content_hash`` (computed over the view-stripped graph) gives content-addressed deploys.\n``view`` is the React-Flow layer and is **never** hashed.",
  "properties": {
    "contentHash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contenthash"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata"
    },
    "models": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelBinding"
      },
      "title": "Models",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "schemaVersion": {
      "title": "Schemaversion",
      "type": "string"
    },
    "tools": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "builtin": "#/$defs/BuiltinTool",
            "http": "#/$defs/HttpTool",
            "mcp": "#/$defs/McpTool"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BuiltinTool"
          },
          {
            "$ref": "#/$defs/HttpTool"
          },
          {
            "$ref": "#/$defs/McpTool"
          }
        ]
      },
      "title": "Tools",
      "type": "object"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "view": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "View"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version"
  ],
  "title": "IRDocument",
  "type": "object"
}

{
  "ir": {
    "schemaVersion": "1.0", "id": "agt_remote_llm", "name": "remote-llm", "version": "0.1.0",
    "models": {
      "remote": { "binding": "openai-compatible", "model": "claude-sonnet-5", "params": { "maxTokens": 1024 } }
    },
    "tools": {},
    "nodes": [
      { "id": "n_in",  "type": "input",  "kind": "boundary", "ports": { "in": [], "out": [{"id":"out"}] } },
      { "id": "n_llm", "type": "llm", "kind": "activity",
        "config": { "model": "remote", "messages": [
          { "role": "system", "content": "You are a concise assistant. Answer directly, no preamble." },
          { "role": "user", "content": "$in" }
        ] },
        "ports": { "in": [{"id":"in"}], "out": [{"id":"ok"},{"id":"err","type":"error"}] } },
      { "id": "n_out", "type": "output", "kind": "boundary", "ports": { "in": [{"id":"in"}], "out": [] } }
    ],
    "edges": [
      { "id":"e1","source":"n_in","sourceHandle":"out","target":"n_llm","targetHandle":"in","channel":"data" },
      { "id":"e2","source":"n_llm","sourceHandle":"ok","target":"n_out","targetHandle":"in","channel":"data" }
    ]
  },
  "input": "In one sentence: why does a local-first architecture reduce vendor lock-in?",
  "stream": false
}
